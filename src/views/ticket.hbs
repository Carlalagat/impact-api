<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Your Tickets</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f8f8f8;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0px 3px 6px rgba(0,0,0,0.1);
      }
      h1 {
        text-align: center;
        color: #333;
      }
      .ticket {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
      }
      .ticket h3 {
        margin-top: 0;
        color: #2b2b2b;
      }
      .ticket p {
        font-size: 14px;
        color: #555;
      }
      .qr {
        text-align: center;
        margin-top: 10px;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #777;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Your Event Tickets 🎟</h1>
      <p>Hi {{name}},</p>
      <p>Thanks for your purchase! Below are your tickets — each with its own QR code. You can either scan directly from this email or download the attached PNG files.</p>

      {{#each tickets}}
        <div class="ticket">
          <h3>{{eventName}}</h3>
          <p><strong>Ticket Code:</strong> {{code}}</p>
          <div class="qr">
            <img src="{{qrImage}}" alt="QR Code" width="200" height="200" />
          </div>
        </div>
      {{/each}}

      <p>Have fun at the event! 🎉</p>

      <div class="footer">
        &copy; {{year}} Ticketing System. All rights reserved.
      </div>
    </div>
  </body>
</html>
